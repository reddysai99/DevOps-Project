# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database Config - Neon Cloud (for production)
# This should be your actual Neon Cloud database URL
# Example: postgres://username:password@ep-example-123456.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=

# Security
TRUST_PROXY=true